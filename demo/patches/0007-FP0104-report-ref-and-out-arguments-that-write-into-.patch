From 38ae235711a0b4614733ecf19db0be1002fc4ea3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 21:07:22 +0100
Subject: [PATCH 07/12] FP0104: report ref and out arguments that write into a
 parameter's object

An argument bound to a ref or out parameter (decided by the parameter's kind, not the keyword at the
call) is checked like an assignment target: `int.TryParse(text, out box.Count)` and `ref values[0]`
are reported at the argument expression. `ref readonly` and `in` parameters, locals, `out var` and the
method's own parameters stay unreported.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011nXBkinjHz24B8aadiHZjn
---
 ancplua-fprog.Tests/Rules/Fp0104Tests.cs      | 104 +++++++++++++++++-
 .../Rules/Fp0104ParameterWriteAnalyzer.cs     |  20 +++-
 2 files changed, 116 insertions(+), 8 deletions(-)

diff --git a/ancplua-fprog.Tests/Rules/Fp0104Tests.cs b/ancplua-fprog.Tests/Rules/Fp0104Tests.cs
index f75264f..d0d769e 100644
--- a/ancplua-fprog.Tests/Rules/Fp0104Tests.cs
+++ b/ancplua-fprog.Tests/Rules/Fp0104Tests.cs
@@ -1055,7 +1055,7 @@ public sealed class Fp0104Tests(TestContext testContext)
         """);
 
     [TestMethod]
-    public Task FP0104_RefAndOutArgumentsAreNotAssignments_NoReport() => VerifyAsync("""
+    public Task FP0104_RefAndOutArgumentsIntoParameterObject_Reports() => VerifyAsync("""
         public static class Io
         {
             public static bool TryRead(string text, out int value) => int.TryParse(text, out value);
@@ -1068,12 +1068,110 @@ public sealed class Fp0104Tests(TestContext testContext)
         {
             public static int Read(Box box, int[] values)
             {
-                var ok = Io.TryRead("1", out box.Count);
-                return Io.Bump(ref values[0]) + (ok ? box.Count : 0);
+                var ok = Io.TryRead("1", out {|FP0104:box.Count|});
+                return Io.Bump(ref {|FP0104:values[0]|}) + (ok ? box.Count : 0);
             }
         }
         """);
 
+    [TestMethod]
+    public Task FP0104_OutArgumentOfBclMethodIntoParameterObject_Reports() => VerifyAsync("""
+        [Fprog.FunctionalCore]
+        public static class Reader
+        {
+            public static bool Read(string text, Box box) => int.TryParse(text, out {|FP0104:box.Count|});
+
+            public static bool ReadInto(string text, int[] slots) => int.TryParse(text, out {|FP0104:slots[0]|});
+
+            public static bool Deep(string text, Box box)
+                => int.TryParse(text, out {|FP0104:box.Items[0].Inner!.Count|})
+                   && int.TryParse(text, out {|FP0104:(box.Items[0].Count)|});
+        }
+        """);
+
+    [TestMethod]
+    public Task FP0104_RefArgumentToLocalFunctionConstructorAndSwap_Reports() => VerifyAsync("""
+        public sealed class Cell
+        {
+            public Cell(ref int slot) => slot++;
+        }
+
+        public static class Lib
+        {
+            public static void Swap(ref int a, ref int b) => (a, b) = (b, a);
+        }
+
+        [Fprog.FunctionalCore]
+        public static class Ops
+        {
+            public static int Touch(Box box, int[] values, ref Point point)
+            {
+                Lib.Swap(ref {|FP0104:values[0]|}, ref {|FP0104:values[1]|});
+                _ = new Cell(ref {|FP0104:box.Count|});
+                Bump(ref {|FP0104:point.X|});
+                return Bump(ref {|FP0104:box.Inner!.Items[0].Count|});
+
+                static int Bump(ref int value) => ++value;
+            }
+        }
+        """);
+
+    [TestMethod]
+    public Task FP0104_RefReadonlyInAndLocalArguments_NoReport() => VerifyAsync("""
+        public sealed class State
+        {
+            public int Count;
+            public long Total;
+        }
+
+        public static class Lib
+        {
+            public static int Peek(ref readonly int value) => value;
+            public static int PeekIn(in int value) => value;
+            public static int Bump(ref int value) => ++value;
+        }
+
+        [Fprog.FunctionalCore]
+        public static class Ops
+        {
+            public static int ReadOnlyRef(State state) => Lib.Peek(ref state.Count);
+
+            public static int InArgument(State state) => Lib.PeekIn(in state.Count) + Lib.PeekIn(state.Count);
+
+            public static long VolatileRead(State state) => System.Threading.Volatile.Read(ref state.Total);
+
+            public static System.ReadOnlySpan<int> View(State state) => new(in state.Count);
+
+            public static int Locals(string text)
+            {
+                int.TryParse(text, out var parsed);
+                int local;
+                int.TryParse(text, out local);
+                var cells = new int[1];
+                return parsed + local + Lib.Bump(ref cells[0]) + Lib.Bump(ref local);
+            }
+
+            public static bool OwnOutParameter(string text, out int value) => int.TryParse(text, out value);
+
+            public static int OwnRefParameter(ref int value, string text, int fallback)
+            {
+                int.TryParse(text, out fallback);
+                return Lib.Bump(ref value) + fallback;
+            }
+
+            public static int StructParameterByValue(Point point) => Lib.Bump(ref point.X);
+        }
+        """);
+
+    [TestMethod]
+    public Task FP0104_RefAndOutArgumentsOutsideCore_NoReport() => VerifyAsync("""
+        public static class Shell
+        {
+            public static bool Read(string text, Box box, int[] values)
+                => int.TryParse(text, out box.Count) && int.TryParse(text, out values[0]);
+        }
+        """);
+
     private Task VerifyAsync(string source)
         => FpAnalyzerTestHost.VerifyRuleAsync("FP0104", source + Types, testContext.CancellationToken);
 }
diff --git a/ancplua-fprog/Rules/Fp0104ParameterWriteAnalyzer.cs b/ancplua-fprog/Rules/Fp0104ParameterWriteAnalyzer.cs
index 69513c4..75dd95d 100644
--- a/ancplua-fprog/Rules/Fp0104ParameterWriteAnalyzer.cs
+++ b/ancplua-fprog/Rules/Fp0104ParameterWriteAnalyzer.cs
@@ -11,15 +11,19 @@ namespace ancplua_fprog.Rules;
 
 /// <summary>
 /// FP0104: inside the functional core, an assignment, compound assignment, <c>??=</c>, deconstruction
-/// assignment, event subscription, <c>++</c> or <c>--</c> whose target is a field, property, event or
-/// element reached from a parameter whose type may be a reference (class, interface, array, delegate,
+/// assignment, event subscription, <c>++</c>, <c>--</c>, or argument bound to a <c>ref</c> or <c>out</c>
+/// parameter, whose target is a field, property, event or element reached from a parameter whose type may be a reference (class, interface, array, delegate,
 /// <c>dynamic</c>, type parameter not known to be a value type) or from a <c>ref</c>/<c>out</c>
 /// parameter. The chain from the parameter to the target may pass through fields, properties, indexers,
 /// array elements, casts, null-conditional access and method calls. Writes through a struct parameter
 /// passed by value, <c>in</c> or <c>ref readonly</c> (<c>Span&lt;T&gt;</c> and structs holding references
 /// included) are not reported. Writes into a boxed copy are not reported unless the chain above the box
-/// reads a reference or passes through a member that returns by reference. Reported at the whole
-/// assignment target expression, including enclosing parentheses.
+/// reads a reference or passes through a member that returns by reference. Whether an argument counts
+/// is decided by the kind of the parameter it is bound to, not by the keyword at the call: arguments to
+/// <c>in</c> and <c>ref readonly</c> parameters (<c>Volatile.Read(ref p.Total)</c>) are reads; passing a
+/// local, an <c>out var</c> or a parameter itself is not reported. Arguments of dynamic calls are not
+/// checked. Reported at the whole assignment target expression (for an argument: the expression after
+/// <c>ref</c>/<c>out</c>), including enclosing parentheses.
 /// </summary>
 [DiagnosticAnalyzer(LanguageNames.CSharp)]
 public sealed class Fp0104ParameterWriteAnalyzer : DiagnosticAnalyzer
@@ -45,7 +49,8 @@ public sealed class Fp0104ParameterWriteAnalyzer : DiagnosticAnalyzer
             OperationKind.DeconstructionAssignment,
             OperationKind.EventAssignment,
             OperationKind.Increment,
-            OperationKind.Decrement);
+            OperationKind.Decrement,
+            OperationKind.Argument);
     }
 
     private static void Analyze(OperationAnalysisContext context)
@@ -71,6 +76,11 @@ public sealed class Fp0104ParameterWriteAnalyzer : DiagnosticAnalyzer
             case IIncrementOrDecrementOperation increment:
                 Check(context, increment.Target, rebinds: false);
                 break;
+            case IArgumentOperation { Parameter.RefKind: RefKind.Ref or RefKind.Out } argument:
+                // The callee may write the storage it receives. The parameter decides, not the keyword at the
+                // call: `ref x` passed to a `ref readonly` parameter, and every `in` argument, cannot be written.
+                Check(context, argument.Value, rebinds: false);
+                break;
         }
     }
 
