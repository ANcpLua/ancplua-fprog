index 59c8626..a01cc8f 100644
--- a/ancplua-fprog/Rules/Fp0801ImperativeShellAnalyzer.cs
+++ b/ancplua-fprog/Rules/Fp0801ImperativeShellAnalyzer.cs
@@ -13,9 +13,41 @@ namespace ancplua_fprog.Rules;
 /// of <c>System.Console</c>, <c>System.Diagnostics.Process</c>, or one of the threading types
 /// <c>Thread</c>, <c>Monitor</c>, <c>Lock</c>, <c>Mutex</c>, <c>Semaphore</c>, <c>SemaphoreSlim</c>,
 /// <c>Interlocked</c> and <c>Timer</c> in <c>System.Threading</c> (their nested types, such as
-/// <c>Lock.Scope</c>, are not listed), and at the <c>lock</c> keyword. Only names that bind to a type are
-/// reported: a member reached without a type name token (<c>using static</c>, inherited statics) is not.
-/// <c>using</c> directives and <c>var</c> are not reported.
+/// <c>Lock.Scope</c>, are not listed), and at the <c>lock</c> keyword. <c>using</c> directives and <c>var</c>
+/// are not reported.
+/// <para>
+/// Code that uses the shell without writing such a type name is reported too, at a name token
+/// (<see cref="Fp0801ShellUses"/>):
+/// </para>
+/// <list type="bullet">
+/// <item>A static member of a forbidden type (method, also as a method group, property, field, constant, enum
+/// member, event) written as a simple name that binds through <c>using static</c> or <c>global using static</c>:
+/// reported at that name, whatever else the member contains. This includes pure members such as
+/// <c>GetExtension</c> from <c>System.IO.Path</c> or the constant <c>Open</c> from <c>System.IO.FileMode</c>;
+/// that is deliberate, because the same code with the type written (<c>Path.GetExtension</c>,
+/// <c>FileMode.Open</c>) is reported at the type name. Not reported: the operand of <c>nameof</c>; a static
+/// member that an enclosing type inherits from a forbidden base type and uses unqualified (the base list names the
+/// type and is reported); a call bound at run time unless every candidate is a member of a forbidden type.</item>
+/// <item>An instance member (method, property, field, event) on an uncovered receiver whose static type is
