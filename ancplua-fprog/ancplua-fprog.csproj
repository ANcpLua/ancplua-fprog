<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <RootNamespace>ancplua_fprog</RootNamespace>
    </PropertyGroup>

    <!-- NuGet package: the analyzer DLL under analyzers/dotnet/cs, the Fprog attributes as a source
         content file, no lib/ folder and no dependencies. See "Package and release" in AGENTS.md. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>ANcpLua.Fprog.Analyzers</PackageId>
        <VersionPrefix>0.4.0</VersionPrefix>
        <Authors>Alexander Nachtmann</Authors>
        <Description>Roslyn analyzers that hold C# 15 code to functional-programming rules: purity, immutability and totality inside types marked [Fprog.FunctionalCore], and complete matching over union types and closed classes.</Description>
        <PackageTags>roslyn;analyzers;functional-programming;immutability;discriminated-unions</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/ANcpLua/ancplua-fprog</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Microsoft.CodeAnalysis.CSharp stays at or below the compiler of the pinned SDK (CS9057). No Workspaces. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="contentFiles/**"/>
        <None Remove="contentFiles/**"/>
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="contentFiles/FprogAttributes.cs" Pack="true" PackagePath="contentFiles/cs/any/Fprog/" BuildAction="Compile" PackageCopyToOutput="false"/>
        <None Include="../README.md" Pack="true" PackagePath="/" Visible="false"/>
        <None Include="../LICENSE" Pack="true" PackagePath="/" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ancplua-fprog.Tests"/>
    </ItemGroup>

</Project>
