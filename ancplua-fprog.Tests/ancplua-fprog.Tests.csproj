<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Basic.Reference.Assemblies.Net110" Version="1.8.13" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
        <!-- Explicit, or the testing library resolves Roslyn 1.0.1 and the test host does not compile.
             Keep equal to the analyzer's Microsoft.CodeAnalysis.CSharp version. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <!-- Override the vulnerable transitive version from the Roslyn test framework. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../ancplua-fprog/ancplua-fprog.csproj" />
    </ItemGroup>

</Project>
